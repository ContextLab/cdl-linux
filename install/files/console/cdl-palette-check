#!/usr/bin/env bash
# Measure the palette's contrast instead of believing it.
#
# Spec §9.7: "Contrast is checked rather than assumed. The archived design found that its
# own ANSI black sat at 1.24:1 against the background while the document claimed every
# colour cleared 4.5:1, which is the sort of error that survives because nobody measures a
# colour scheme."  So this runs in the test suite, on the shipped palette, every time.
#
# Usage: cdl-palette-check [palette.conf]
#
# Exit 0  every threshold met
#      1  at least one colour is too close to the background
#      2  the file is missing, unreadable, or does not define what it must
#
# Thresholds. WCAG 2.1 contrast ratios, computed against the palette's own background:
#
#   foreground  >= 7.0:1   (AAA for body text; this is what you read all day)
#   each colour >= 3.0:1   (AA for large text / non-text; the floor for a glyph that has
#                           to be identifiable at all)
#
# 3:1 for the sixteen is a deliberate floor rather than 4.5:1. An ANSI palette has to
# span a hue circle at two brightnesses; demanding 4.5:1 of all sixteen collapses the
# normal and bright rows into each other. What must never happen is the archived
# design's failure -- a colour that is effectively invisible -- and 3:1 is the threshold
# below which that is what it is.
#
# No dependencies. Pure bash integer arithmetic, so it runs in the installer's
# environment, in a container, and on a macOS test host, without python3 or bc.

set -uo pipefail

palette="${1:-/etc/cdl/palette.conf}"

[ -r "$palette" ] || { printf 'cdl-palette-check: cannot read %s\n' "$palette" >&2; exit 2; }

FG_MIN=70   # 7.0:1, in tenths
C_MIN=30    # 3.0:1, in tenths

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    P_OK=$'\033[32m'; P_BAD=$'\033[31m'; P_OFF=$'\033[0m'
else
    P_OK=; P_BAD=; P_OFF=
fi

# --- reading -------------------------------------------------------------------------
# One awk pass, so a malformed line is ignored the same way everywhere.
val() { awk -F= -v k="$1" '$1==k {gsub(/[ \t\r]/,"",$2); print $2; exit}' "$palette"; }

# --- luminance -----------------------------------------------------------------------
# WCAG relative luminance needs a 2.4 power on a fractional base, and bash has no floats.
# Rather than shell out to python3 -- which would make this tool depend on an interpreter
# the installer does not otherwise need -- the sRGB-to-linear transfer function is
# evaluated in fixed point.
#
# Scale: luminance is carried as an integer in units of 1e-7. That is enough resolution
# that the ratios below agree with a float implementation at the tenth of a ratio point
# this reports, which is all the thresholds need. (Cross-checked while this was written:
# for all eighteen shipped values the integer result equals floor(float_ratio * 10)
# exactly -- 14.36 -> 14.3, 3.05 -> 3.0, and so on. Truncating rather than rounding is
# deliberate: it can only understate a ratio, so it never passes a colour that a float
# implementation would fail.)
#
# lin(c) for c in 0..255:  cs = c/255
#     cs <= 0.03928 -> cs/12.92
#     else          -> ((cs+0.055)/1.055) ^ 2.4
#
# x^2.4 is computed as x^2 * x^0.4, and x^0.4 by five Newton iterations on y^5 = x^2
# (since x^0.4 = (x^2)^(1/5)). All in integer arithmetic scaled by 1e7.
S=10000000   # 1e7

# integer square-free 5th root of n (scaled), by Newton on y^5 = n
root5() {
    local n="$1" y=$S i
    [ "$n" -le 0 ] && { printf '0'; return; }
    # 6 iterations converges for the whole 0..1e7 domain from this start
    for i in 1 2 3 4 5 6 7 8; do
        # y = (4y + n/y^4)/5   in scaled arithmetic
        local y2=$(( y * y / S ))
        local y4=$(( y2 * y2 / S ))
        [ "$y4" -eq 0 ] && break
        y=$(( (4 * y + n * S / y4) / 5 ))
    done
    printf '%s' "$y"
}

# linear-light value of one 0..255 channel, scaled by 1e7
lin() {
    local c="$1"
    # cs = c/255, scaled
    local cs=$(( c * S / 255 ))
    if [ "$cs" -le 392800 ]; then      # 0.03928
        printf '%s' $(( cs * S / 129200 ))   # cs / 12.92
        return
    fi
    # x = (cs + 0.055)/1.055
    local x=$(( (cs + 550000) * S / 10550000 ))
    # x^2.4 = x^2 * (x^2)^(1/5)
    local x2=$(( x * x / S ))
    local r; r="$(root5 "$x2")"
    printf '%s' $(( x2 * r / S ))
}

# relative luminance of #rrggbb, scaled by 1e7
lum() {
    local h="${1#\#}"
    local r=$((16#${h:0:2})) g=$((16#${h:2:2})) b=$((16#${h:4:2}))
    local lr lg lb
    lr="$(lin "$r")"; lg="$(lin "$g")"; lb="$(lin "$b")"
    printf '%s' $(( (2126 * lr + 7152 * lg + 722 * lb) / 10000 ))
}

# contrast ratio of two colours, in tenths (so 45 means 4.5:1)
ratio() {
    local la lb hi lo
    la="$(lum "$1")"; lb="$(lum "$2")"
    if [ "$la" -ge "$lb" ]; then hi=$la; lo=$lb; else hi=$lb; lo=$la; fi
    # (hi + 0.05) / (lo + 0.05), in tenths
    printf '%s' $(( ( (hi + 500000) * 10 ) / (lo + 500000) ))
}

is_hex() { [[ "$1" =~ ^#[0-9a-fA-F]{6}$ ]]; }

# --- run ------------------------------------------------------------------------------
bg="$(val background)"; fg="$(val foreground)"

for n in background:$bg foreground:$fg; do
    k="${n%%:*}"; v="${n#*:}"
    [ -n "$v" ]  || { printf 'cdl-palette-check: %s is not defined in %s\n' "$k" "$palette" >&2; exit 2; }
    is_hex "$v"  || { printf 'cdl-palette-check: %s is "%s", not #rrggbb\n' "$k" "$v" >&2; exit 2; }
done

fails=0
printf 'palette: %s\n' "$palette"
printf 'background %s\n\n' "$bg"

r="$(ratio "$fg" "$bg")"
if [ "$r" -ge "$FG_MIN" ]; then
    printf '  %sPASS%s  %-11s %s  %d.%d:1  (need %d.%d:1)\n' \
        "$P_OK" "$P_OFF" foreground "$fg" $((r/10)) $((r%10)) $((FG_MIN/10)) $((FG_MIN%10))
else
    printf '  %sFAIL%s  %-11s %s  %d.%d:1  (need %d.%d:1)\n' \
        "$P_BAD" "$P_OFF" foreground "$fg" $((r/10)) $((r%10)) $((FG_MIN/10)) $((FG_MIN%10))
    fails=$((fails+1))
fi

for i in $(seq 0 15); do
    k="color$i"; v="$(val "$k")"
    if [ -z "$v" ]; then
        printf 'cdl-palette-check: %s is not defined in %s\n' "$k" "$palette" >&2; exit 2
    fi
    if ! is_hex "$v"; then
        printf 'cdl-palette-check: %s is "%s", not #rrggbb\n' "$k" "$v" >&2; exit 2
    fi
    r="$(ratio "$v" "$bg")"
    if [ "$r" -ge "$C_MIN" ]; then
        printf '  %sPASS%s  %-11s %s  %d.%d:1\n' "$P_OK" "$P_OFF" "$k" "$v" $((r/10)) $((r%10))
    else
        printf '  %sFAIL%s  %-11s %s  %d.%d:1  (need %d.%d:1)\n' \
            "$P_BAD" "$P_OFF" "$k" "$v" $((r/10)) $((r%10)) $((C_MIN/10)) $((C_MIN%10))
        fails=$((fails+1))
    fi
done

# The accent is optional -- a palette without one is still valid -- but if it is present
# it is drawn on the same background as everything else and is held to the same floor.
accent="$(val accent)"
if [ -n "$accent" ] && is_hex "$accent"; then
    r="$(ratio "$accent" "$bg")"
    if [ "$r" -ge "$C_MIN" ]; then
        printf '  %sPASS%s  %-11s %s  %d.%d:1\n' "$P_OK" "$P_OFF" accent "$accent" $((r/10)) $((r%10))
    else
        printf '  %sFAIL%s  %-11s %s  %d.%d:1  (need %d.%d:1)\n' \
            "$P_BAD" "$P_OFF" accent "$accent" $((r/10)) $((r%10)) $((C_MIN/10)) $((C_MIN%10))
        fails=$((fails+1))
    fi
fi

printf '\n'
if [ "$fails" -eq 0 ]; then
    printf '%sall contrast thresholds met%s\n' "$P_OK" "$P_OFF"
    exit 0
fi
printf '%s%d colour(s) below threshold%s\n' "$P_BAD" "$fails" "$P_OFF"
exit 1
