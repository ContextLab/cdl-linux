#!/usr/bin/env bash
# Generate every themed surface from /etc/cdl/palette.conf.
#
# Spec §9.7: "Generating them from one file is the point. A palette maintained in six
# places is a palette that is subtly different in six places."  So nothing below is
# hand-written; each output is derived from the same eighteen values.
#
# Usage: cdl-palette-apply [--palette FILE] [--out-dir DIR] [--quiet]
#
#   --palette FILE   read this instead of /etc/cdl/palette.conf
#   --out-dir DIR    write under DIR instead of the real system paths. Used by the test
#                    suite, which has to generate and inspect the output on a machine
#                    that is not the target and must not be modified by a test.
#
# Generated:
#
#   <etc>/kmscon-palette.conf   kmscon's palette-* options, included by kmscon.conf
#   <etc>/vtrgb                 setvtrgb input: three lines of sixteen decimals
#   <etc>/zsh-colors.zsh        shell colour variables, sourced by /etc/cdl/zshrc
#   <etc>/zellij/themes/cdl.kdl the zellij theme
#   <etc>/palette.css           CSS custom properties for the dashboard (§8)
#
# Exit 0 on success, 2 if the palette is unusable. Idempotent: rewriting an identical
# file is avoided, so `cdl-palette-apply` twice reports no change the second time.

set -uo pipefail

PALETTE=/etc/cdl/palette.conf
OUT=/etc/cdl
quiet=0

while [ $# -gt 0 ]; do
    case "$1" in
        --palette) PALETTE="${2:?--palette needs a file}"; shift 2 ;;
        --out-dir) OUT="${2:?--out-dir needs a directory}"; shift 2 ;;
        --quiet)   quiet=1; shift ;;
        -h|--help) sed -n '2,26p' "$0" | sed -E 's/^#[[:space:]]?//'; exit 0 ;;
        *) printf 'cdl-palette-apply: unknown argument %s\n' "$1" >&2; exit 2 ;;
    esac
done

[ -r "$PALETTE" ] || { printf 'cdl-palette-apply: cannot read %s\n' "$PALETTE" >&2; exit 2; }

say() { [ "$quiet" -eq 1 ] || printf '%s\n' "$*" >&2; }

val() { awk -F= -v k="$1" '$1==k {gsub(/[ \t\r]/,"",$2); print $2; exit}' "$PALETTE"; }

# Load all eighteen (plus the optional accent) once, and refuse early if any is malformed.
# A generator that emits a half-valid theme file is worse than one that refuses: the
# broken value would reach kmscon's config parser and the VT at boot.
declare -a COL
for i in $(seq 0 15); do
    v="$(val "color$i")"
    [[ "$v" =~ ^#[0-9a-fA-F]{6}$ ]] || { printf 'cdl-palette-apply: color%d is "%s", not #rrggbb\n' "$i" "$v" >&2; exit 2; }
    COL[i]="$v"
done
BG="$(val background)"; FG="$(val foreground)"; ACCENT="$(val accent)"
for n in background:$BG foreground:$FG; do
    [[ "${n#*:}" =~ ^#[0-9a-fA-F]{6}$ ]] || { printf 'cdl-palette-apply: %s is "%s", not #rrggbb\n' "${n%%:*}" "${n#*:}" >&2; exit 2; }
done
# An absent accent falls back to the brightest green rather than to nothing, so every
# consumer can rely on the variable existing.
[[ "$ACCENT" =~ ^#[0-9a-fA-F]{6}$ ]] || ACCENT="${COL[10]}"

r() { printf '%d' "$((16#${1:1:2}))"; }
g() { printf '%d' "$((16#${1:3:2}))"; }
b() { printf '%d' "$((16#${1:5:2}))"; }

# Write only on change, so a second run is silent and file mtimes do not churn (which
# would make `lsinitramfs`-style staleness checks lie). Returns 0 if it wrote.
write_if_changed() {
    local f="$1" new; new="$(cat)"
    if [ -f "$f" ] && [ "$(cat "$f")" = "$new" ]; then
        return 1
    fi
    mkdir -p "$(dirname "$f")"
    printf '%s\n' "$new" > "$f"
    return 0
}

changed=0
note() { changed=$((changed+1)); say "    wrote $1"; }

HEADER="# generated by cdl-palette-apply from ${PALETTE}; edits here are overwritten"

# --- kmscon ---------------------------------------------------------------------------
# kmscon takes its palette as palette-<name> options holding "r,g,b". The names are
# kmscon's own (black..white, then light-*), which is why this is a mapping table rather
# than a loop: ANSI index 8..15 are "light-<colour>" and not "bright<n>".
kmscon_names=(black red green yellow blue magenta cyan light-grey
              dark-grey light-red light-green light-yellow light-blue light-magenta light-cyan white)
{
    printf '%s\n' "$HEADER"
    printf 'palette=custom\n'
    for i in $(seq 0 15); do
        printf 'palette-%s=%d,%d,%d\n' "${kmscon_names[i]}" "$(r "${COL[i]}")" "$(g "${COL[i]}")" "$(b "${COL[i]}")"
    done
    printf 'palette-foreground=%d,%d,%d\n' "$(r "$FG")" "$(g "$FG")" "$(b "$FG")"
    printf 'palette-background=%d,%d,%d\n' "$(r "$BG")" "$(g "$BG")" "$(b "$BG")"
} | write_if_changed "$OUT/kmscon-palette.conf" && note "$OUT/kmscon-palette.conf"

# --- kernel VT (setvtrgb) --------------------------------------------------------------
# setvtrgb's file format is exactly three lines: all sixteen red values, then all sixteen
# green, then all sixteen blue, comma-separated decimals. It is NOT one line per colour,
# which is the mistake that produces a VT with a scrambled palette and no error message.
{
    for ch in r g b; do
        out=""
        for i in $(seq 0 15); do
            out="${out}${out:+,}$($ch "${COL[i]}")"
        done
        printf '%s\n' "$out"
    done
} | write_if_changed "$OUT/vtrgb" && note "$OUT/vtrgb"

# --- zsh --------------------------------------------------------------------------------
{
    printf '%s\n' "$HEADER"
    printf '# Hex values for anything that takes them, and the accent the prompt uses.\n'
    for i in $(seq 0 15); do printf 'CDL_COLOR%d=%s\n' "$i" "${COL[i]}"; done
    printf 'CDL_FG=%s\nCDL_BG=%s\nCDL_ACCENT=%s\n' "$FG" "$BG" "$ACCENT"
    printf '\n# LS_COLORS/eza and friends take 256-colour indices, not hex. The prompt uses\n'
    printf '# the ANSI indices directly so it stays correct under any terminal that honours\n'
    printf '# the palette above -- which, after cdl-palette-apply, is all of them.\n'
    printf 'CDL_ANSI_ACCENT=2\nCDL_ANSI_DIM=8\nCDL_ANSI_WARN=3\nCDL_ANSI_BAD=1\nCDL_ANSI_GOOD=10\n'
} | write_if_changed "$OUT/zsh-colors.zsh" && note "$OUT/zsh-colors.zsh"

# --- zellij -------------------------------------------------------------------------------
{
    printf '// %s\n' "${HEADER#\# }"
    printf 'themes {\n    cdl {\n'
    printf '        fg "%s"\n'  "$FG"
    printf '        bg "%s"\n'  "$BG"
    printf '        black "%s"\n'   "${COL[0]}"
    printf '        red "%s"\n'     "${COL[1]}"
    printf '        green "%s"\n'   "${COL[2]}"
    printf '        yellow "%s"\n'  "${COL[3]}"
    printf '        blue "%s"\n'    "${COL[4]}"
    printf '        magenta "%s"\n' "${COL[5]}"
    printf '        cyan "%s"\n'    "${COL[6]}"
    printf '        white "%s"\n'   "${COL[7]}"
    printf '        orange "%s"\n'  "${COL[3]}"
    printf '    }\n}\n'
} | write_if_changed "$OUT/zellij/themes/cdl.kdl" && note "$OUT/zellij/themes/cdl.kdl"

# --- dashboard CSS ---------------------------------------------------------------------
# Eighteen custom properties: the sixteen ANSI slots plus foreground and background, which
# is what §9.7's table means by "CSS variables, from the same source file". The accent is
# emitted as a nineteenth under its own name.
{
    printf '/* %s */\n' "${HEADER#\# }"
    printf ':root {\n'
    for i in $(seq 0 15); do printf '  --cdl-color%d: %s;\n' "$i" "${COL[i]}"; done
    printf '  --cdl-foreground: %s;\n' "$FG"
    printf '  --cdl-background: %s;\n' "$BG"
    printf '  --cdl-accent: %s;\n' "$ACCENT"
    printf '}\n'
} | write_if_changed "$OUT/palette.css" && note "$OUT/palette.css"

if [ "$changed" -eq 0 ]; then
    say "palette: already current (5 files)"
else
    say "palette: regenerated $changed file(s)"
fi
exit 0
