# CDL system-wide zsh configuration.  Sourced from /etc/zsh/zshrc by one guarded line.
#
# Spec §9.5: the prompt shows "host, path, git branch and GPU state, so a reattached
# session says what machine it is on".  Everything here is system-wide on purpose -- a
# person's own ~/.zshrc is theirs and is sourced after this, so anything set here can be
# overridden without editing a root-owned file.
#
# THIS FILE IS SOURCED BY EVERY INTERACTIVE ZSH, AND MUST NOT LAUNCH ANYTHING.  §9.1 is
# explicit that `cdl` is "launched from the login shell explicitly, never from
# .profile", and the reasoning applies with equal force here: a launcher that runs from
# a shell rc captures `ssh host cmd`, `scp`, `rsync` and git-over-SSH.  This file sets
# variables, defines a prompt and defines aliases.  It starts no programs.

# Non-interactive shells get nothing.  A prompt, a completion system and a set of
# aliases are all meaningless to `ssh host 'cmd'`, and building them wastes time on
# every rsync.
[[ -o interactive ]] || return

# --- palette ------------------------------------------------------------------------
# Generated by cdl-palette-apply.  Absent on a machine where the palette module has not
# run yet, which is not an error: the prompt below degrades to the terminal's own
# colours rather than failing.
[[ -r /etc/cdl/zsh-colors.zsh ]] && source /etc/cdl/zsh-colors.zsh
: "${CDL_ANSI_ACCENT:=2}" "${CDL_ANSI_DIM:=8}" "${CDL_ANSI_WARN:=3}" "${CDL_ANSI_BAD:=1}" "${CDL_ANSI_GOOD:=10}"

# --- history --------------------------------------------------------------------------
# Shared, appended, de-duplicated, and NOT written for a command typed with a leading
# space.  The last of those matters on a machine that holds tokens: `HIST_IGNORE_SPACE`
# is the mechanism by which a one-off command carrying a secret stays out of the file.
HISTFILE=${HOME}/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY

setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS
setopt INTERACTIVE_COMMENTS
setopt NO_BEEP

# --- completion --------------------------------------------------------------------------
# compinit's security check stats every directory in fpath and prompts if any is
# group-writable.  A prompt during a login on a machine nobody is watching is a hang, so
# the check is run in the non-interactive form: insecure directories are skipped, not
# asked about.
autoload -Uz compinit && compinit -C
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:descriptions' format "%F{$CDL_ANSI_DIM}%d%f"

# --- keys ----------------------------------------------------------------------------
# Emacs bindings.  The original requirements (D3) put keybinding quality at HIGH
# priority, and this is the half of it that lives on the box; the terminal client's own
# key handling stays on the client, per §9.5.
bindkey -e
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^[[A' history-beginning-search-backward-end
bindkey '^[[B' history-beginning-search-forward-end

# --- git branch in the prompt -----------------------------------------------------------
# vcs_info rather than parsing `git status`: it is built in, it is fast, and it does not
# fork a git process on every prompt in a directory that is not a repository.
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats       " %F{$CDL_ANSI_WARN}%b%f%u%c"
zstyle ':vcs_info:git:*' actionformats " %F{$CDL_ANSI_WARN}%b%f|%F{$CDL_ANSI_BAD}%a%f%u%c"
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' unstagedstr   "%F{$CDL_ANSI_BAD}*%f"
zstyle ':vcs_info:git:*' stagedstr     "%F{$CDL_ANSI_GOOD}+%f"

# --- GPU state in the prompt ---------------------------------------------------------
# §9.5 wants GPU state visible.  nvidia-smi takes tens of milliseconds, which is too slow
# to run on every prompt, so the value is cached and refreshed on a timer.  On a machine
# with no NVIDIA GPU -- the arm64 test VM, a laptop without one -- this prints nothing at
# all rather than an error or a placeholder, which is what "else nothing" means.
CDL_GPU_CACHE_SECONDS=10
typeset -g _cdl_gpu_text="" _cdl_gpu_when=0

_cdl_gpu() {
    (( $+commands[nvidia-smi] )) || return
    local now=$EPOCHSECONDS
    if (( now - _cdl_gpu_when < CDL_GPU_CACHE_SECONDS )); then
        print -rn -- "$_cdl_gpu_text"
        return
    fi
    _cdl_gpu_when=$now
    local out
    # A GPU that is busy, missing or held by another process must not wedge the prompt.
    # Failure of any kind produces an empty segment.
    out=$(nvidia-smi --query-gpu=utilization.gpu,memory.used,memory.total \
                     --format=csv,noheader,nounits 2>/dev/null | head -1) || out=""
    if [[ -z "$out" ]]; then
        _cdl_gpu_text=""
    else
        local util used total
        IFS=', ' read -r util used total <<< "$out"
        if [[ -n "$util" && -n "$used" && -n "$total" ]]; then
            _cdl_gpu_text=" %F{$CDL_ANSI_DIM}gpu%f %F{$CDL_ANSI_ACCENT}${util}%%%f %F{$CDL_ANSI_DIM}$((used/1024))/$((total/1024))G%f"
        else
            _cdl_gpu_text=""
        fi
    fi
    print -rn -- "$_cdl_gpu_text"
}

zmodload zsh/datetime 2>/dev/null

precmd_cdl() { vcs_info }
autoload -Uz add-zsh-hook
add-zsh-hook precmd precmd_cdl

setopt PROMPT_SUBST

# host  path  git  gpu
#  >
# The marker is the accent colour, and it is red when the last command failed -- the one
# piece of state that is worth a colour change rather than a word.
PROMPT='%F{$CDL_ANSI_ACCENT}%n%f%F{$CDL_ANSI_DIM}@%f%F{$CDL_ANSI_ACCENT}%m%f %F{$CDL_ANSI_GOOD}%~%f${vcs_info_msg_0_}$(_cdl_gpu)
%(?.%F{$CDL_ANSI_ACCENT}.%F{$CDL_ANSI_BAD})%(!.#.>)%f '
RPROMPT=''

# --- zellij ----------------------------------------------------------------------------
# §9.7's generated config lives in /etc/cdl/zellij and is shared by every user, so a
# person gets the palette and the agent layout without a copy in their home directory.
# ZELLIJ_CONFIG_DIR is how zellij is told to look there.
export ZELLIJ_CONFIG_DIR=/etc/cdl/zellij

# §9.4: "zellij's own session resurrection is disabled, because a pane's contents
# surviving a reboot in a cache directory is a copy of the same material with none of the
# same care."  The config file sets this too; the variable is belt and braces for a
# session started with an explicit --config.
export ZELLIJ_AUTO_ATTACH=false
export ZELLIJ_AUTO_EXIT=false

# --- editor ------------------------------------------------------------------------------
if (( $+commands[emacsclient] )); then
    export EDITOR='emacsclient -t -a emacs'
    export VISUAL="$EDITOR"
elif (( $+commands[emacs] )); then
    export EDITOR=emacs VISUAL=emacs
fi
export PAGER=less
export LESS='-R -F -X'

# --- tools -------------------------------------------------------------------------------
# Every alias is guarded on the tool actually being installed.  §9.5 names these, but a
# module may have skipped one, and an alias to a missing binary is a broken shell rather
# than a missing feature.
if (( $+commands[eza] )); then
    alias ls='eza --group-directories-first'
    alias ll='eza -l --git --group-directories-first --time-style=long-iso'
    alias la='eza -la --git --group-directories-first --time-style=long-iso'
    alias lt='eza --tree --level=2 --group-directories-first'
else
    alias ll='ls -l' la='ls -la'
fi

# Debian ships bat as batcat, because `bat` collides with an unrelated package.
if (( $+commands[batcat] )); then
    alias bat='batcat'
    alias cat='batcat --paging=never'
    export BAT_THEME='ansi'
elif (( $+commands[bat] )); then
    alias cat='bat --paging=never'
    export BAT_THEME='ansi'
fi

# ...and fd as fdfind, for the same reason.
(( $+commands[fdfind] )) && alias fd='fdfind'

# delta reads git's config, not an alias, so the module sets it in /etc/gitconfig.  The
# variable here only affects delta run directly.
(( $+commands[delta] )) && export DELTA_FEATURES='+side-by-side'

alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias rg='rg --smart-case'

# `cdl` is a real executable in /usr/local/bin (§9.1) -- deliberately not an alias, so
# that `ssh host cdl status`, scp and rsync all behave.  Nothing here launches it.
