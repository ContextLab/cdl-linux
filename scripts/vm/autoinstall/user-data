#cloud-config
# Autoinstall declaration for the cdl-box storage layout.
#
# This file IS the install procedure. Spec §12 asks for a runbook that has been executed
# twice; a declarative file executed twice is a stronger form of the same thing, because
# there is no step for a human to perform differently the second time.
#
# The layout under test, bottom to top:
#
#   vda1 ESP            512M   /boot/efi
#   vda2 /boot          2G     unencrypted, because GRUB must read the kernel before
#                              anything is unlocked
#   vda3 + vdb1         20G ea raid0 -> md0 -> LUKS -> btrfs -> /
#
# Sizes are explicit and equal for the two raid members. mdadm tolerates unequal members
# but wastes the difference, and an accidental mismatch is the kind of thing that is
# invisible until someone wonders where the space went.

autoinstall:
  version: 1

  # Serial console, so the harness can drive the LUKS prompt on reboot. This is also how
  # the real machine should be configured: a headless box whose only console is a screen
  # nobody is sitting at is harder to recover than one that talks to a serial line.
  kernel:
    package: linux-generic

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: cdl-box-vm
    username: cdl
    # mkpasswd -m sha-512 'cdl-vm-test' -- test-only credential, never leaves the VM
    password: "$6$rounds=4096$cdlvmtest$1YJHtNQ0hZbdQPBvJ0nCLRoxhY8dMvHOaU8Xw5hLXHUoHYWRlxLZ0zZs.RQ8bYCLIf1XyH2NxvxLxJm2n2xEc/"

  ssh:
    install-server: true
    allow-pw: true

  # Curtin cannot express btrfs subvolumes in its storage config, and the spec's layout
  # needs three of them (@ for root, @home, @models). So the stack is built here, before
  # curtin runs, and curtin is then handed the finished filesystem with preserve: true.
  #
  # UNVERIFIED as of 2026-09-02. This is exactly what spike S2 exists to settle, and the
  # verifier now fails until the three subvolumes are present, rather than passing on the
  # flat btrfs root that draft 1 of this harness produced.
  early-commands:
    - |
      set -eux
      # Partition disk0: ESP, /boot, raid member. disk1: one matching raid member.
      sgdisk --zap-all /dev/vda
      sgdisk --zap-all /dev/vdb
      sgdisk -n1:0:+512M -t1:ef00 -c1:esp  /dev/vda
      sgdisk -n2:0:+2G   -t2:8300 -c2:boot /dev/vda
      sgdisk -n3:0:+20G  -t3:fd00 -c3:raid /dev/vda
      sgdisk -n1:0:+20G  -t1:fd00 -c1:raid /dev/vdb
      partprobe /dev/vda; partprobe /dev/vdb; udevadm settle

      # RAID0 across the two equal members.
      mdadm --create /dev/md0 --level=0 --raid-devices=2 --metadata=1.2 --run /dev/vda3 /dev/vdb1
      udevadm settle

      # LUKS. The passphrase is a test credential and is meant to be public.
      printf '%s' 'cdl-vm-test-passphrase' | cryptsetup luksFormat --type luks2 --batch-mode /dev/md0 -
      printf '%s' 'cdl-vm-test-passphrase' | cryptsetup open /dev/md0 cryptroot -

      # btrfs, then the three subvolumes the spec asks for.
      mkfs.btrfs -f -L cdlroot /dev/mapper/cryptroot
      mount /dev/mapper/cryptroot /mnt
      btrfs subvolume create /mnt/@
      btrfs subvolume create /mnt/@home
      btrfs subvolume create /mnt/@models
      umount /mnt

      mkfs.ext4 -F -L cdlboot /dev/vda2
      mkfs.vfat -F32 -n ESP /dev/vda1

  storage:
    config:
      # Everything below is preserve: true -- early-commands already built it. curtin's job
      # here is to mount the right subvolumes and install into them, not to create anything.
      - {type: disk, id: disk0, path: /dev/vda, ptable: gpt, preserve: true, grub_device: true}
      - {type: disk, id: disk1, path: /dev/vdb, ptable: gpt, preserve: true}

      - {type: partition, id: p_esp,  device: disk0, number: 1, size: 512M, flag: boot, preserve: true, grub_device: true}
      - {type: partition, id: p_boot, device: disk0, number: 2, size: 2G,   preserve: true}
      - {type: partition, id: p_r0,   device: disk0, number: 3, size: 20G,  preserve: true}
      - {type: partition, id: p_r1,   device: disk1, number: 1, size: 20G,  preserve: true}

      - {type: raid, id: md0, name: md0, raidlevel: raid0, devices: [p_r0, p_r1], preserve: true}
      - {type: dm_crypt, id: crypt0, volume: md0, dm_name: cryptroot, key: cdl-vm-test-passphrase, preserve: true}

      - {type: format, id: f_root, volume: crypt0, fstype: btrfs, preserve: true}
      - {type: format, id: f_boot, volume: p_boot, fstype: ext4,  preserve: true}
      - {type: format, id: f_esp,  volume: p_esp,  fstype: fat32, preserve: true}

      - {type: mount, id: m_root,   device: f_root, path: /,           options: 'subvol=/@'}
      - {type: mount, id: m_home,   device: f_root, path: /home,       options: 'subvol=/@home'}
      - {type: mount, id: m_models, device: f_root, path: /srv/models, options: 'subvol=/@models'}
      - {type: mount, id: m_boot,   device: f_boot, path: /boot}
      - {type: mount, id: m_esp,    device: f_esp,  path: /boot/efi}

  packages:
    - mdadm
    - cryptsetup
    - cryptsetup-initramfs
    - btrfs-progs
    - restic
    - rclone
    - openssh-server

  late-commands:
    # Serial console on the installed system, so a reboot can be driven and observed
    # without a display. Matches the headless design.
    - curtin in-target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty1 console=ttyAMA0,115200"/' /etc/default/grub
    - curtin in-target -- sed -i 's/^#\?GRUB_TERMINAL=.*/GRUB_TERMINAL="console serial"/' /etc/default/grub
    - curtin in-target -- update-grub

    # Record what the installer actually produced, so the verification step compares
    # against reality rather than against this file's intent.
    - curtin in-target -- sh -c 'mkdir -p /var/log/cdl'
    - curtin in-target -- sh -c 'lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT > /var/log/cdl/lsblk.txt 2>&1 || true'
    - curtin in-target -- sh -c 'cat /etc/crypttab > /var/log/cdl/crypttab.txt 2>&1 || true'
    - curtin in-target -- sh -c 'cat /etc/fstab > /var/log/cdl/fstab.txt 2>&1 || true'
    - curtin in-target -- sh -c 'cat /proc/mdstat > /var/log/cdl/mdstat.txt 2>&1 || true'
    - curtin in-target -- sh -c 'lsinitramfs /boot/initrd.img-$(ls /lib/modules | head -1) 2>/dev/null | grep -cE "cryptsetup|md" > /var/log/cdl/initramfs-bits.txt 2>&1 || true'
