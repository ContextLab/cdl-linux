#cloud-config
# Autoinstall declaration for the cdl-box storage layout.
#
# This file IS the install procedure. Spec §12 asks for a runbook that has been executed
# twice; a declarative file executed twice is a stronger form of the same thing, because
# there is no step for a human to perform differently the second time.
#
# The layout under test, bottom to top:
#
#   vda1 ESP            512M   /boot/efi
#   vda2 /boot          2G     unencrypted, because GRUB must read the kernel before
#                              anything is unlocked
#   vda3 + vdb1         20G ea raid0 -> md0 -> LUKS -> btrfs -> /
#
# Sizes are explicit and equal for the two raid members. mdadm tolerates unequal members
# but wastes the difference, and an accidental mismatch is the kind of thing that is
# invisible until someone wonders where the space went.

autoinstall:
  version: 1

  # Serial console, so the harness can drive the LUKS prompt on reboot. This is also how
  # the real machine should be configured: a headless box whose only console is a screen
  # nobody is sitting at is harder to recover than one that talks to a serial line.
  kernel:
    package: linux-generic

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: cdl-box-vm
    username: cdl
    # Generated with `openssl passwd -6`, not written by hand. An earlier version of this
    # file carried a hash with a comment claiming it was the hash of this password; it was
    # not, and nothing could have logged in with it. A credential with a comment asserting
    # what it is, and no check that the assertion holds, is worse than no comment.
    password: "$6$FNRiK45R/TSwA7m4$HdImOzaZZxm6UoSabgCs7kQuSRkhCmPsFi15RF/Kf2NKukucZyzh7F4MKteEfftrOIg41KHZ1xgSxzgaesX3C1"

  # Key-only, which is what §7 of the spec requires and what the harness should model.
  # The key is generated per checkout into $VM_WORK and is never committed.
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - "@@CDL_VM_PUBKEY@@"

  # ATTEMPT 4. Attempt 3 built the stack in early-commands and handed curtin
  # `preserve: true`; curtin crashed with "'NoneType' object has no attribute 'size'".
  # Separately, subiquity is documented to silently drop storage:config:mount:options, so
  # the `subvol=` mounts would have been ignored even had curtin survived.
  #
  # So this attempt lets curtin build the stack the way it supports, and asks one question:
  # does curtin create btrfs subvolumes on its own? Ubuntu's guided btrfs installs use @ and
  # @home, so the capability exists somewhere; what is unknown is whether an autoinstall
  # storage config reaches it. The verifier answers that, and it fails if the answer is no.
  storage:
    config:
      - {type: disk, id: disk0, path: /dev/vda, ptable: gpt, wipe: superblock-recursive, preserve: false, grub_device: false}
      - {type: disk, id: disk1, path: /dev/vdb, ptable: gpt, wipe: superblock-recursive, preserve: false}

      - {type: partition, id: p_esp, device: disk0, size: 512M, flag: boot, grub_device: true}
      - {type: format, id: f_esp, volume: p_esp, fstype: fat32}
      - {type: mount, id: m_esp, device: f_esp, path: /boot/efi}

      # /boot stays outside the encryption: GRUB has to read a kernel before anything can
      # be unlocked.
      - {type: partition, id: p_boot, device: disk0, size: 2G}
      - {type: format, id: f_boot, volume: p_boot, fstype: ext4}
      - {type: mount, id: m_boot, device: f_boot, path: /boot}

      - {type: partition, id: p_raid0, device: disk0, size: 20G}
      - {type: partition, id: p_raid1, device: disk1, size: 20G}

      - {type: raid, id: md0, name: md0, raidlevel: raid0, devices: [p_raid0, p_raid1]}
      - {type: dm_crypt, id: crypt0, volume: md0, dm_name: cryptroot, key: cdl-vm-test-passphrase}

      - {type: format, id: f_root, volume: crypt0, fstype: btrfs}
      - {type: mount, id: m_root, device: f_root, path: /}

  # Power off rather than reboot. install.sh boots the ISO's kernel directly with -kernel,
  # so a reboot re-enters the installer and it reinstalls in a loop -- observed 46 times
  # before it was noticed. Powering off ends the run cleanly and boot.py takes it from there.
  shutdown: poweroff

  packages:
    - mdadm
    - cryptsetup
    - cryptsetup-initramfs
    - btrfs-progs
    - restic
    - rclone
    - openssh-server

  # Power off rather than reboot. install.sh boots the ISO's kernel directly with -kernel,
  # so a reboot re-enters the installer and it reinstalls in a loop -- observed 46 times
  # before it was noticed. Powering off ends the run cleanly and boot.py takes it from there.
  shutdown: poweroff

  late-commands:
    # Migrate root into @ and split out @home and @models.
    #
    # This has to happen HERE, and the two obvious alternatives were both measured and both
    # fail. Snapshotting the running root: `Could not create subvolume: Text file busy`,
    # because btrfs will not snapshot the top-level subvolume while it is mounted as root.
    # Moving the top level's contents from the running system: `Device or resource busy` on
    # /boot, because a directory with a filesystem mounted on it cannot be renamed, and
    # /boot, /proc, /sys, /dev and /run all qualify.
    #
    # In late-commands the filesystem is mounted at /target and nothing is running from it,
    # so the rename is just a rename. curtin has already written /target/etc/fstab, which is
    # why the fstab rewrite happens here too.
    - |
      set -eux
      root_dev=$(findmnt -no SOURCE /target)
      uuid=$(blkid -s UUID -o value "$root_dev")

      # Detach the target and its submounts, deepest first.
      for m in /target/boot/efi /target/boot /target; do
        mountpoint -q "$m" && umount -R "$m" || true
      done

      mkdir -p /tmp/top
      mount -o subvolid=5 "$root_dev" /tmp/top
      btrfs subvolume create /tmp/top/@
      btrfs subvolume create /tmp/top/@home
      btrfs subvolume create /tmp/top/@models

      # Everything except the three new subvolumes moves into @.
      for e in /tmp/top/* /tmp/top/.[!.]*; do
        [ -e "$e" ] || continue
        case "$(basename "$e")" in @|@home|@models) continue ;; esac
        mv "$e" /tmp/top/@/
      done

      # /home becomes its own subvolume rather than a directory inside @.
      if [ -d /tmp/top/@/home ]; then
        for d in /tmp/top/@/home/*; do
          [ -e "$d" ] || continue
          mv "$d" /tmp/top/@home/
        done
      fi
      mkdir -p /tmp/top/@/home /tmp/top/@/srv/models

      # fstab: root from @, plus the two new mounts.
      fstab=/tmp/top/@/etc/fstab
      awk -v u="$uuid" '$2=="/" && $3=="btrfs" { print "UUID=" u " / btrfs defaults,subvol=/@ 0 1"; next } { print }' "$fstab" > "$fstab.new"
      printf 'UUID=%s /home btrfs defaults,subvol=/@home 0 2\n' "$uuid" >> "$fstab.new"
      printf 'UUID=%s /srv/models btrfs defaults,subvol=/@models 0 2\n' "$uuid" >> "$fstab.new"
      mv "$fstab.new" "$fstab"

      umount /tmp/top

      # Put /target back, now from @, so curtin's remaining steps see the new layout.
      mount -o subvol=/@ "$root_dev" /target
      mount -o subvol=/@home "$root_dev" /target/home
      mount -o subvol=/@models "$root_dev" /target/srv/models
      for spec in $(awk '$2=="/boot" || $2=="/boot/efi" {print $1 "|" $2}' "$fstab"); do
        dev=${spec%%|*}; mnt=${spec##*|}
        mkdir -p "/target${mnt}"
        mount "$(echo "$dev" | sed 's/^UUID=/\/dev\/disk\/by-uuid\//')" "/target${mnt}"
      done

    # Rebuild the bootloader against the new layout.
    - curtin in-target -- update-grub
    - curtin in-target -- update-initramfs -u -k all

    # Serial console on the installed system, so a reboot can be driven and observed
    # without a display. Matches the headless design.
    - curtin in-target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="console=tty1 console=ttyAMA0,115200"/' /etc/default/grub
    - curtin in-target -- sed -i 's/^#\?GRUB_TERMINAL=.*/GRUB_TERMINAL="console serial"/' /etc/default/grub
    - curtin in-target -- update-grub

    # Record what the installer actually produced, so the verification step compares
    # against reality rather than against this file's intent.
    - curtin in-target -- sh -c 'mkdir -p /var/log/cdl'
    - curtin in-target -- sh -c 'lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT > /var/log/cdl/lsblk.txt 2>&1 || true'
    - curtin in-target -- sh -c 'cat /etc/crypttab > /var/log/cdl/crypttab.txt 2>&1 || true'
    - curtin in-target -- sh -c 'cat /etc/fstab > /var/log/cdl/fstab.txt 2>&1 || true'
    - curtin in-target -- sh -c 'cat /proc/mdstat > /var/log/cdl/mdstat.txt 2>&1 || true'
    - curtin in-target -- sh -c 'lsinitramfs /boot/initrd.img-$(ls /lib/modules | head -1) 2>/dev/null | grep -cE "cryptsetup|md" > /var/log/cdl/initramfs-bits.txt 2>&1 || true'
    # The question this run exists to answer.
    - curtin in-target -- sh -c 'btrfs subvolume list / > /var/log/cdl/subvolumes.txt 2>&1 || echo NONE > /var/log/cdl/subvolumes.txt'
